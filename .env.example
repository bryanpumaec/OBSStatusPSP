# Dirección del servidor websocket de OBS (OBS 28+ trae obs-websocket integrado)
OBS_WEBSOCKET_URL=ws://127.0.0.1:4455

# Contraseña configurada en OBS: Herramientas > Configuración de WebSocket
OBS_WEBSOCKET_PASSWORD=

# Puerto donde este programa escucha las conexiones de los celulares (uno por cámara)
CAMERA_SOCKET_PORT=9000

# Ruta al archivo de mapeo escena -> número de cámara
SCENE_MAP_PATH=./config/scene-camera-map.json
